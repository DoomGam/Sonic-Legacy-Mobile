<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="Friday Night Funkin': Rodentrap" file="FNF Rodentrap" packageName="com.rodentrap.rodentrapfnf" package="com.rodentrap.rodentrapfnf" main="Main" version="0.2.7" company="TemmieZoneNG" />

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>

	<app preloader="flixel.system.FlxPreloader" />

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" />
	<window if="html5" resizable="true" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false"/>
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />
	
	<!-- PSYCH ENGINE CUSTOMIZATION -->
	<define name="MODS_ALLOWED" if="desktop" />
	<define name="LUA_ALLOWED" if="desktop || android" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="VIDEOS_ALLOWED" unless="32bits"/>
	<define name="PSYCH_WATERMARKS"/>
	<define name="TITLE_SCREEN_EASTER_EGG" if="officialBuild"/>

	<define name="FINAL_BUILD"/>
	
	<!-- EMBED OBRIGATÓRIO PARA MOBILE (Roda tudo dentro do APK) -->
	<define name="EXE_EMBEDDING" if="mobile" />

	<assets path="assets/embeds/images" rename="assets/images" embed="true" if="EXE_EMBEDDING"/>
	<assets path="assets/embeds/data" rename="assets/data" embed="true" if="EXE_EMBEDDING"/>
	<assets path="assets/embeds/characters" rename="assets/characters" embed="true" if="EXE_EMBEDDING"/>
	<assets path="assets/embeds/songs" rename="assets/songs" library="songs" embed="true" if="EXE_EMBEDDING"/>
	<assets path="assets/embeds/stages" rename="assets/stages" embed="true" if="EXE_EMBEDDING"/>
	<assets path="assets/embeds/music" rename="assets/music" embed="true" if="EXE_EMBEDDING"/>
	<assets path="assets/embeds/shaders" rename="assets/shaders" embed="true" if="EXE_EMBEDDING"/>
	<assets path="assets/embeds/sounds" rename="assets/sounds" embed="true" if="EXE_EMBEDDING"/>

	<assets path="assets/embeds/images" rename="assets/images" embed="false" unless="EXE_EMBEDDING"/>
	<assets path="assets/embeds/data" rename="assets/data" embed="false" unless="EXE_EMBEDDING"/>
	<assets path="assets/embeds/characters" rename="assets/characters" embed="false" unless="EXE_EMBEDDING"/>
	<assets path="assets/embeds/songs" rename="assets/songs" library="songs" embed="false" unless="EXE_EMBEDDING"/>
	<assets path="assets/embeds/stages" rename="assets/stages" embed="false" unless="EXE_EMBEDDING"/>
	<assets path="assets/embeds/music" rename="assets/music" embed="false" unless="EXE_EMBEDDING"/>
	<assets path="assets/embeds/shaders" rename="assets/shaders" embed="false" unless="EXE_EMBEDDING"/>
	<assets path="assets/embeds/sounds" rename="assets/sounds" embed="false" unless="EXE_EMBEDDING"/>

	<assets path="assets/preload" rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/preload" rename="assets" exclude="*.mp3" unless="web"/>

	<define name="CHECK_FOR_UPDATES" if="desktop officialBuild"/>
	<define name="loadBenchmark" if="debug"/>

	<define name="PRELOAD_ALL" unless="web" />
	<define name="NO_PRELOAD_ALL" unless="PRELOAD_ALL"/>
	
	<library name="videos" preload="true" />
	<section if="PRELOAD_ALL">
		<library name="songs" preload="true" />
		<library name="shared" preload="true" />
	</section>
	
	<section if="NO_PRELOAD_ALL">
		<library name="songs" preload="true" />
		<library name="shared" preload="false" />
	</section>
	
	<assets path="assets/videos" library="videos" if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs" library="songs" exclude="*.ogg" if="web"/>
	<assets path="assets/songs" library="songs" exclude="*.mp3" unless="web"/>
	<assets path="assets/shared" library="shared" exclude="*.ogg" if="web"/>
	<assets path="assets/shared" library="shared" exclude="*.mp3" unless="web"/>

	<assets path="assets/fonts" embed="true"/>
	
	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" version="5.2.2" />
	<haxedev set="webgl" />

	<haxelib name="flixel-addons" version="2.10.0"/>
	<haxelib name="hscript" />
	<haxelib name="flixel-ui" />
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="faxe" if="switch"/>
	<haxelib name="discord_rpc" if="desktop"/>
	<haxelib name="hxvlc" if="desktop || android"/>
	<haxelib name="hxCodec" if="desktop || android"/>
	<haxelib name="android-manager" if="android" />

	<haxeflag name="--macro" value="include('meta.ui')" />

	<!-- ______________________________ Haxedefines _____________________________ -->

	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	<haxedef name="no-deprecation-warnings"/>
	
	<haxedef name="mobile" if="android" />
	<haxedef name="LUA_BUILD_TYPE" value="RELEASE" if="android" />

	<!-- Configurações do SDK Android -->
	<config :android gradle-version="7.4.2" gradle-plugin="7.4.2" if="android" />
	<android target-sdk-version="33" min-sdk-version="21" if="android" />

	<!-- _________________________________ Custom _______________________________ -->

	<icon path="projFiles/icon/icon16.png" size="16"/>
	<icon path="projFiles/icon/icon32.png" size="32"/>
	<icon path="projFiles/icon/icon64.png" size="64"/>
	<icon path="projFiles/icon/iconOG.png" />
</project>
